# Jira Work Dashboard - 환경변수 예시
# 이 파일을 .env 로 복사한 뒤 자기 값으로 채우세요.
# .env 는 .gitignore 에 의해 추적 안 됨.

# ──────────────────────────────────────
# Jira API 인증
# ──────────────────────────────────────

# Jira 사용자 이메일 (Atlassian 계정)
JIRA_EMAIL=you@example.com

# Jira API Token
# 발급: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=ATATT3xFfGF0...

# (선택) Atlassian MCP 사용 시 위 두 값 대신 OAuth 사용 가능
# Claude Desktop App → Connectors → Atlassian → 인증
# 이 경우 본 파일의 JIRA_* 변수는 무시됨


# ──────────────────────────────────────
# Telegram 알림 (선택)
# ──────────────────────────────────────

# Telegram 봇 토큰 (BotFather 에서 발급)
# 사용 안 하면 빈 문자열로 두거나 변수 자체 제거
TELEGRAM_BOT_TOKEN=

# 알림을 받을 그룹/채널 chat_id (-100... 형식)
TELEGRAM_CHAT_ID=

# 봇이 멘션할 사용자 ID (선택)
ALLOWED_USERS=


# ──────────────────────────────────────
# Google Drive 동기화 (선택)
# ──────────────────────────────────────

# rclone 또는 Google Drive 데스크톱 앱이 마운트한 로컬 경로
# (boards.yaml 의 google_drive_root 와 일치해야 함)
# 사용 안 하면 boards.yaml 의 google_drive_root 를 빈 문자열로


# ──────────────────────────────────────
# 디버그 (선택)
# ──────────────────────────────────────

# DEBUG=jira-dashboard:*
